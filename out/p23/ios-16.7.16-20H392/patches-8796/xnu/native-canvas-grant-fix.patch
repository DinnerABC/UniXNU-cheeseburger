 /* Registered by a service property so its own clients bypass the sandbox verdict. */
 static bool native_sandbox_grant(IOService * service);
+extern "C" void proc_selfname(char *, int);
+static bool native_canvas_grant(IORegistryEntry *entry, const char *property) {
+ if (!property || (strcmp(property, "canvas-width") && strcmp(property, "canvas-height") && strcmp(property, "supports-apt"))) return false;
+ IOService *service = OSDynamicCast(IOService, entry); if (!service) return false;
+ OSObject *obj = service->getProperty("NativeSandboxGrantProcess");
+ OSString *str = OSDynamicCast(OSString, obj); OSData *data = OSDynamicCast(OSData, obj);
+ const char *list = str ? str->getCStringNoCopy() : data ? (const char *)data->getBytesNoCopy() : NULL;
+ size_t size = str ? strlen(list) + 1 : data ? data->getLength() : 0;
+ if (!list || !size || size > 256 || list[size-1] != 0 || strnlen(list, size) != size-1) return false;
+ char name[17] = {}; proc_selfname(name, sizeof(name));
+ for (const char *at = list; *at;) { size_t n = 0; while (at[n] && at[n] != ',') ++n; if (n && !strncmp(name, at, n < 16 ? n : 16) && (n >= 16 || name[n] == 0)) return true; at += n + (at[n] == ',' ? 1 : 0); }
+ return false;
+}
 
