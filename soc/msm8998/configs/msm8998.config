# Keep provider choices explicit. The original Apple providers remain selected.
# CONFIG_XNU_SOURCE_PTHREAD is not set
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# MSM8998 observed UNDEF on MSR PAN; use ARMv8.0 paths throughout.
# CONFIG_XNU_NATIVE_PAN is not set
# Never access the BCM build template panic address on MSM8998.
CONFIG_XNU_DT_PANIC_REGION=y
