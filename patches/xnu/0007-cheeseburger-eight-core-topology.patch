--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -134,8 +134,9 @@
 #include <pexpert/arm64/BCM2837.h>
 
 #define MAX_L2_CLINE                   6
-#define MAX_CPUS                       4
+#define MAX_CPUS                       8
 #define MAX_CPU_CLUSTERS               1
+#define XNU_NATIVE_AFFINITY16           1 /* Native PSCI uses Aff1+Aff0; not Apple HAS_CLUSTER */
 
 #define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
 #endif  /* ARM64_BOARD_CONFIG_BCM2837 */
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -145,7 +145,7 @@
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER
+#if HAS_CLUSTER || XNU_NATIVE_AFFINITY16
 	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
