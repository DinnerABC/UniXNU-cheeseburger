+/* iOS 16 and later build the system domain's daemons from the signed service
+ * cache /System/Library/xpc/launchd.plist (launchd_cache_loader verifies it and
+ * hands it to launchd); a plist that only exists on disk is not discovered at
+ * boot. With boot-arg sgac=1 this step copies the sealed cache, adds one daemon
+ * through the board's bplist editor, writes the result into Data and mounts it
+ * over /System/Library/xpc as a read-only union. The loader reads it only when
+ * launchd_unsecure_cache= is present in the boot arguments, so the step also
+ * requires that string in the loader binary and rolls the mount back if the
+ * augmented file does not read back through the union exactly. */
+struct native_launchd_cache_stats {
+	uint64_t input_bytes, output_bytes, objects, daemons;
+	uint32_t offset_size, ref_size;
+	int error;
+};
+extern int cheeseburger_launchd_cache_size(const uint8_t *, uint64_t, const char *, const char *, uint64_t *,
+    struct native_launchd_cache_stats *) __attribute__((weak_import));
+extern int cheeseburger_launchd_cache_build(const uint8_t *, uint64_t, const char *, const char *, uint8_t *, uint64_t,
+    struct native_launchd_cache_stats *) __attribute__((weak_import));
+volatile int native_gpu_addon_cache_stage = 0;
+volatile int native_gpu_addon_cache_status = -1;
+volatile int native_gpu_addon_cache_loader = -1;
+volatile int native_gpu_addon_cache_mount_stage = 0;
+volatile int native_gpu_addon_cache_mount_status = -1;
+volatile int native_gpu_addon_cache_rollback = -1;
+volatile uint64_t native_gpu_addon_cache_input = 0;
