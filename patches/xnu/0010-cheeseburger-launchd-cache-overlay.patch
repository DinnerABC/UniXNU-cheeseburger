+volatile int native_gpu_addon_cache_objects = -1;
+volatile int native_gpu_addon_cache_daemons = -1;
+static int
+native_gpu_addon_read_file(const char *path, uint64_t cap, uint8_t **data, uint64_t *size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_current();
+	uint8_t *buffer = NULL;
+	uint64_t bytes = 0;
+	int resid = 0;
+	int error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	error = vnode_getattr(vp, &va, ctx);
+	if (!error && (!va.va_data_size || va.va_data_size > cap)) {
+		error = E2BIG;
+	}
+	if (!error) {
+		bytes = va.va_data_size;
+		buffer = kalloc_data((size_t)bytes, Z_WAITOK);
+		if (!buffer) {
+			error = ENOMEM;
+		}
+	}
+	if (!error) {
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)bytes, 0, UIO_SYSSPACE, IO_NOAUTH,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	if (error) {
+		if (buffer) {
+			kfree_data(buffer, (size_t)bytes);
+		}
+		return error;
+	}
+	*data = buffer;
+	*size = bytes;
+	return 0;
+}
+static int
+native_gpu_addon_contains(const uint8_t *haystack, uint64_t bytes, const char *needle, uint64_t length)
+{
+	if (!bytes || bytes < length) {
+		return 0;
+	}
+	for (uint64_t i = 0; i + length <= bytes; i++) {
+		if (haystack[i] == (uint8_t)needle[0] && !memcmp(haystack + i, needle, (size_t)length)) {
+			return 1;
+		}
+	}
+	return 0;
+}
+/* The addon install that wrote into the Data mount during activation hung on
+ * this board; its final MNT_WAIT fsync is the suspected stall. The loader only
+ * needs the contents through the vnode cache, so publish the cache without a
+ * synchronous store flush. */
+static int
+native_gpu_addon_write_nosync(const char *path, const uint8_t *data, uint64_t size, uint32_t mode, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, mode, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)size, 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (!error && resid) {
+		error = EIO;
+	}
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, mode);
+		error = vnode_setattr(vp, &va, ctx);
 	}
+	int close_error = vnode_close(vp, FWRITE, ctx);
+	return error ? error : close_error;
 }
 static void
+native_gpu_addon_cache(proc_t p, user_addr_t scratch)
+{
+	static const char sealed_path[] = "/System/Library/xpc/launchd.plist";
+	static const char loader_path[] = "/usr/libexec/launchd_cache_loader";
+	static const char source[] = "/private/var/mobile/ngpu/xpc";
+	static const char output_path[] = "/private/var/mobile/ngpu/xpc/launchd.plist";
+	static const char point[] = "/System/Library/xpc";
+	static const char plist_key[] = "/System/Library/LaunchDaemons/org.cheeseburger.adrenoprobed.plist";
+	static const char program[] = "/private/var/mobile/ngpu/bin/adrenoprobed";
