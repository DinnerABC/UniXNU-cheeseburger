+	uint8_t *in = NULL, *out = NULL, *check = NULL, *loader = NULL;
+	uint64_t in_size = 0, out_size = 0, check_size = 0, loader_size = 0;
+	struct native_launchd_cache_stats stats = {0};
+	vfs_context_t ctx = vfs_context_current();
+	int error;
+
+	native_gpu_addon_cache_stage = 1;
+	error = native_gpu_addon_read_file(sealed_path, 16ull << 20, &in, &in_size);
+	native_gpu_addon_cache_input = in_size;
+	if (error) {
+		goto done;
+	}
+	native_gpu_addon_cache_loader = 0;
+	if (!native_gpu_addon_read_file(loader_path, 4ull << 20, &loader, &loader_size)) {
+		native_gpu_addon_cache_loader = native_gpu_addon_contains(loader, loader_size, unsecure,
+		    sizeof(unsecure) - 1);
+		kfree_data(loader, (size_t)loader_size);
+	}
+	if (!native_gpu_addon_cache_loader || !cheeseburger_launchd_cache_size || !cheeseburger_launchd_cache_build) {
+		error = ENOTSUP;
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 2;
+	error = cheeseburger_launchd_cache_size(in, in_size, plist_key, program, &out_size, &stats);
+	native_gpu_addon_cache_output = out_size;
+	native_gpu_addon_cache_objects = (int)stats.objects;
+	native_gpu_addon_cache_daemons = (int)stats.daemons;
+	if (error) {
+		goto done;
+	}
+	out = kalloc_data((size_t)out_size, Z_WAITOK);
+	if (!out) {
+		error = ENOMEM;
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 3;
+	error = cheeseburger_launchd_cache_build(in, in_size, plist_key, program, out, out_size, &stats);
+	if (error) {
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 4;
+	error = native_gpu_addon_parents(p, scratch, output_path);
+	if (error) {
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 5;
+	error = native_gpu_addon_write_nosync(output_path, out, out_size, 0644, ctx);
+	if (error) {
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 6;
