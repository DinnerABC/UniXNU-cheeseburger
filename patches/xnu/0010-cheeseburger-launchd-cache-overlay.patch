+	    "/System/Library/xpc/extensions.plist", plist_key, &native_gpu_addon_cache_mount_stage,
+	    &native_gpu_addon_cache_mount_status);
+	error = native_gpu_addon_cache_mount_status;
+	if (error) {
+		goto done;
+	}
+	native_gpu_addon_cache_stage = 7;
+	error = native_gpu_addon_read_file(sealed_path, out_size + 4096, &check, &check_size);
+	if (!error && (check_size != out_size || memcmp(check, out, (size_t)out_size))) {
+		error = EIO;
+	}
+done:
+	if (error && native_gpu_addon_cache_mount_stage == 5) {
+		vnode_t root = NULLVP;
+		if (!vnode_lookup(point, 0, &root, ctx) && root) {
+			mount_t mounted = vnode_mount(root);
+			vnode_put(root);
+			if (mounted) {
+				native_gpu_addon_cache_rollback = dounmount(mounted, 0, 0, ctx);
+			}
+		}
+	}
+	native_gpu_addon_cache_status = error;
+	if (in) {
+		kfree_data(in, (size_t)in_size);
+	}
+	if (out) {
+		kfree_data(out, (size_t)out_size);
+	}
+	if (check) {
+		kfree_data(check, (size_t)check_size);
+	}
+}
