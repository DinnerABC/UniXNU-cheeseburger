+/* Board visible diagnostics, using the already validated mapping. */
+extern boolean_t p8_console_ready(void);
+extern void p8_console_char(char);
+static void p21_console_stage(const char *s) {
+ if(!p8_console_ready()) return;
+ while(*s) p8_console_char(*s++);
+ p8_console_char('\n');
+}
